# ---------------------------------------------------------------------------
# VASP pseudopotentials are licensed and MUST NOT be redistributed.
# Every run directory ships POTCAR_INFO.txt instead, listing the PAW datasets
# needed to rebuild POTCAR from your own VASP distribution.
# ---------------------------------------------------------------------------
POTCAR
POTCAR.*
*/POTCAR
**/POTCAR

# Large VASP binaries / restart files — regenerate, don't version
WAVECAR
WAVEDER
CHG
CHGCAR
PROCAR
DOSCAR
EIGENVAL
LOCPOT
ELFCAR
PARCHG
TMPCAR
vasprun.xml
XDATCAR
PCDAT
IBZKPT
REPORT
vaspout.h5
vaspwave.h5

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# OS / editor cruft
desktop.ini
.DS_Store
Thumbs.db
.~lock.*#
~$*
.vscode/
.idea/

# Figure images regenerated by ml/pipeline/figures_v3/figure*.py.
# The canonical rendered set lives in figures/.
ml/pipeline/figures_v3/*.png
ml/pipeline/figures_v3/*.pdf
ml/pipeline/figures_v3/*.svg
